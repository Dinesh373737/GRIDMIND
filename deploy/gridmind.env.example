# Copy to the service's protected EnvironmentFile. Do not commit the live file.
GRIDMIND_MODE=aws
AWS_REGION=YOUR_EXISTING_REGION
GRIDMIND_AWS_ACCOUNT_ID=000000000000
GRIDMIND_DDB_TABLE=gridmind-events
GRIDMIND_DDB_HASH_KEY=run_id
GRIDMIND_DDB_RANGE_KEY=step
GRIDMIND_DDB_RANGE_TYPE=N
GRIDMIND_EXPORT_BUCKET=gridmind-exports-el
GRIDMIND_EXPORT_PREFIX=gridmind/runs
GRIDMIND_EVENT_DIR=/var/lib/gridmind/events
GRIDMIND_COGNITO_REGION=YOUR_EXISTING_POOL_REGION
GRIDMIND_COGNITO_USER_POOL_ID=REGION_POOLID
GRIDMIND_COGNITO_CLIENT_ID=YOUR_EXISTING_PUBLIC_APP_CLIENT_ID
GRIDMIND_CORS_ORIGINS=https://YOUR_EXISTING_AMPLIFY_HOST
GRIDMIND_DATABASE_URL=mysql+pymysql://gridmind:URL_ENCODED_PASSWORD@127.0.0.1:3306/gridmind
# Optional after account/model-access/credit preflight; local mode never calls Bedrock.
GRIDMIND_BEDROCK_ENABLED=0
